#!/usr/bin/env bash
# godkey — admin CLI wrapper (works from ~/app/fl or anywhere)
# Usage: ./godkey reset <new-passkey>  |  ./godkey clear
# Equivalent to: cd backend && uv run python -m app.godkey ...
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BACKEND="$ROOT/backend"
# Prefer uv (handles venv creation), fallback to .venv python
if command -v uv >/dev/null 2>&1 && [ -f "$BACKEND/pyproject.toml" ]; then
  exec uv run --project "$BACKEND" python -m app.godkey "$@"
elif [ -x "$BACKEND/.venv/bin/python" ]; then
  cd "$BACKEND"
  exec .venv/bin/python -m app.godkey "$@"
else
  echo "error: no uv or $BACKEND/.venv/bin/python found" >&2
  echo "hint: cd backend && uv sync" >&2
  exit 1
fi
